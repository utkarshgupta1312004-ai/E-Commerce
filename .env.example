# ==============================================================================
# Cartivo E-Commerce Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Django Core Security & Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite in ecom/db.sqlite3)
# DATABASE_URL=sqlite:///db.sqlite3

# Google OAuth2 Authentication Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini AI Assistant Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
