# ==============================================================================
# Cartivo E-Commerce - Production Environment Configuration Template (.env.example)
# Copy this file to .env for local development or enter these in Render Environment Variables.
# NEVER commit your real .env file or production secrets to Git.
# ==============================================================================

# Django Core Security & Settings
SECRET_KEY=your-production-secret-key-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database Configuration (Render Managed PostgreSQL)
# Render automatically provides this when attaching a PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:port/database

# Optional: Initial Production Superuser Bootstrap
# Set these on Render to automatically create an administrator on first deploy.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
DJANGO_SUPERUSER_EMAIL=admin@cartivo.local

# Google Gemini AI Assistant Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth2 Authentication (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production Security Tuning (Optional)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
